# =====================================================================
# DevFlow Community Platform - Environment Configuration Template
# =====================================================================
# Copy this file to .env.local for local development.
# NEVER commit real production secrets or API keys to version control.
# =====================================================================

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Razorpay Payment Gateway Configuration (Task 3: Subscriptions)
# Obtain test credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_never_commit

# Email Gateway Configuration (Task 2 & Task 5: Password Reset & French OTP)
# Compatible with Resend, SendGrid, or standard SMTP
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_placeholder_api_key
EMAIL_FROM=no-reply@devflow.org

# SMS Gateway Configuration (Task 5: Mobile OTP Verification for EN, ES, HI, PT, ZH)
# Compatible with Twilio, Fast2SMS, or MSG91
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_placeholder_twilio_sid
TWILIO_AUTH_TOKEN=placeholder_twilio_auth_token
TWILIO_PHONE_NUMBER=+15005550006

# Security & Session Configuration (Task 6)
SESSION_SECRET=placeholder_cryptographic_session_salt_min_32_chars
DEFAULT_SESSION_EXPIRY_MINUTES=60
